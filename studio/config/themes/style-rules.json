{
  "schemaVersion": 1,
  "rules": {
    "theme-001": ".song-cover.starlight{background:radial-gradient(ellipse at 54% 45%,#ec9fab3b,transparent 45%),linear-gradient(155deg,#151936,#322957 60%,#543f5c)}",
    "theme-002": ".song-cover.starlight:before{content:\"✧  ·  ✦   ·   ✧\";position:absolute;top:11%;color:#eed2a9;letter-spacing:50px;text-shadow:0 0 15px #f9cde0}",
    "theme-003": ".song-cover.starlight:after{content:\"♬\";font:100px Georgia,serif;color:#efcbb6aa;filter:drop-shadow(0 0 18px #f9deb6aa)}",
    "theme-004": ".player-view.theme-starlight{--gold:#f2c9dd;--panel:#1d263d;--panel-soft:#202f4a;--border:rgba(230,192,228,.28);--theme-accent:#f2c9dd;--note:#acb8e9;--chord:#f2c9dd}",
    "theme-005": ".player-view.theme-starlight .play-controls{background:linear-gradient(115deg,#242849f2,#242d50f2,#382f54f2)}",
    "theme-006": ".player-view.theme-starlight .pane{background:linear-gradient(135deg,#202b49f2,#1c2b43e6)}",
    "theme-007": ".player-view.theme-starlight .beat{background:#243452}",
    "theme-008": ".stage-pane.theme-starlight{background:radial-gradient(ellipse at 60% 60%,#ecc4d233,transparent 56%),linear-gradient(150deg,#141934,#29284b 60%,#332b50)}",
    "theme-009": ".stage-pane.theme-starlight .stage-scenery{display:none}",
    "theme-010": ".stage-pane.theme-starlight.has-custom-image .stage-scenery{display:grid}",
    "theme-011": ".stage-pane.theme-starlight:before{content:'✧';font:120px Georgia,serif;color:#edd2e288;position:absolute;inset:0;display:grid;place-items:center;text-shadow:0 0 45px #ead9ea}",
    "theme-012": ".stage-pane.theme-starlight:after{content:'♬';font:72px Georgia,serif;color:#f1b9de99;position:absolute;right:10%;top:15%;filter:drop-shadow(0 0 15px #ffdcff)}",
    "theme-013": "\n.player-view.theme-citylights .pane{background:linear-gradient(135deg,#2c2844dd,#1f2748dd)}",
    "theme-014": "\n.player-view.theme-citylights .play-controls{background:linear-gradient(115deg,#292442,#402c51,#202b4d)}",
    "theme-015": "\n.stage-pane.theme-citylights{background:radial-gradient(ellipse at 68% 37%,#fdd0b855,transparent 43%),linear-gradient(155deg,#231e40,var(--scene-bg,#302641) 70%,#764b6c)}",
    "theme-016": "\n.stage-pane.theme-citylights::before{content:'';position:absolute;inset:10% 0 4%;background:repeating-linear-gradient(90deg,transparent 0 30px,#d9b6ac48 30px 32px,transparent 32px 48px);clip-path:polygon(0% 85%,0 54%,6% 54%,6% 68%,12% 68%,12% 44%,18% 44%,18% 80%,24% 80%,24% 60%,30% 60%,30% 37%,36% 37%,36% 59%,43% 59%,43% 21%,49% 21%,49% 73%,56% 73%,56% 50%,62% 50%,62% 70%,69% 70%,69% 30%,77% 30%,77% 62%,84% 62%,84% 42%,92% 42%,92% 64%,100% 64%,100% 100%,0 100%);opacity:.62;pointer-events:none}",
    "theme-017": "\n.stage-pane.theme-citylights::after{content:'✧';position:absolute;left:14%;top:8%;font:70px Georgia;color:#f2c89b55;text-shadow:0 0 35px #ffd6ba}",
    "theme-018": "\n.player-view.theme-citylights .roll-pane canvas{background:#232441}",
    "theme-019": "\n.player-view.theme-starlight .beat:not(.active):not(.empty){background:linear-gradient(147deg,#2d3555,#1e2b43);border-color:#626b8b}",
    "theme-020": "\n.player-view .beat,.player-view.theme-starlight .beat:not(.active):not(.empty){background:linear-gradient(147deg,var(--player-grid-start),var(--player-grid-end));border-color:var(--player-border)}",
    "theme-021": "\n.player-view:not([data-theme=christmas]) .stage-tree,.player-view:not([data-theme=christmas]) .stage-lantern,.player-view .has-custom-image .stage-tree,.player-view .has-custom-image .stage-lantern{display:none}",
    "theme-022": "\n.player-view[data-theme=christmas] .stage-motif,.player-view .has-custom-image .stage-motif{display:none}",
    "theme-023": "\n.player-view[data-theme=christmas] .key-tile.active{background:linear-gradient(145deg,#806748,#d0a86b);border-color:#f1cb8d}",
    "theme-024": "\n.player-view[data-theme=christmas] .beat{border-color:#3b5a45}",
    "theme-025": "\n.player-view[data-theme=christmas] .beat-number{color:#9cbea5}",
    "theme-026": "\n.player-view[data-theme=christmas] .beat-name{color:#cae6ce}",
    "theme-027": "\n.player-view[data-theme=christmas] .beat.empty .beat-name{color:#5c7a6b}",
    "theme-028": "\n.player-view[data-theme=christmas] .beat.active{border-color:#ffe6ad;box-shadow:0 0 0 1px #f3d398,0 0 18px #e4ac5890}",
    "theme-029": "\n.player-view[data-theme=christmas] .beat.active .beat-number{color:#fff3cd}",
    "theme-030": "\n.player-view[data-theme=christmas] .beat.active .beat-name{color:#fff8e3}",
    "theme-031": "\n.player-view[data-theme=christmas] .beat:hover{border-color:#f2d69e}",
    "theme-032": "\n .player-view[data-theme=christmas] .roll-pane{background:linear-gradient(147deg,#16382fdc,#0a2728f7 75%)}",
    "theme-033": "\n .player-view[data-theme=christmas] .keys-pane{background:linear-gradient(120deg,#1d3e32f7,#2d2427eb)}",
    "theme-034": "\n .player-view[data-theme=christmas] .workspace-right{background:radial-gradient(ellipse at 85% 90%,#36483d3d,transparent 43%),linear-gradient(140deg,#15372fe8,#102522f9)}",
    "theme-035": "\n .player-view[data-theme=christmas] .play-controls{background:linear-gradient(113deg,#123a30e9,#172b29ed 58%,#302729df);border-color:#e0be8d55}",
    "theme-036": "\n .player-view[data-theme=christmas] #stagePane{background:radial-gradient(ellipse 58% 67% at 53% 78%,#f4cb9440,transparent 84%),linear-gradient(180deg,#132e2c00,#193c3847 50%,#58705b23)}",
    "theme-037": "\n.player-view[data-theme=christmas]::before{background:radial-gradient(ellipse at 12% 0%,#32472c 0%,transparent 35%),radial-gradient(ellipse at 90% 88%,#492a2b 0%,transparent 42%),radial-gradient(ellipse at 84% 2%,#123b33 0%,transparent 44%),linear-gradient(135deg,#071b19 0%,#0a211b 52%,#1d1d20 100%)}",
    "theme-038": "\n.player-view[data-theme=christmas] .pane{border-color:rgba(227,211,166,.25)}",
    "theme-039": "\n.player-view[data-theme=christmas] .pane::after,.player-view[data-theme=christmas] .workspace-right::after{background:radial-gradient(circle,#bf4c58 0 2px,transparent 2.5px) 0 0/20px 4px;opacity:.65}",
    "theme-040": ".player-view[data-theme=christmas] .stage-pane:not(.has-custom-image) .stage-scenery{inset:auto;left:50%;bottom:0;height:94%;aspect-ratio:2/1;max-width:91%;width:auto;transform:translateX(-50%)}",
    "theme-041": ".player-view[data-theme=christmas] .stage-pane:not(.has-custom-image) .stage-scenery{height:92%}"
  }
}
