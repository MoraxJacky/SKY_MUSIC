{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sky Music Studio data-only theme",
  "type": "object",
  "required": [
    "format",
    "schemaVersion",
    "definition"
  ],
  "properties": {
    "format": {
      "const": "skytheme"
    },
    "schemaVersion": {
      "const": 2
    },
    "definition": {
      "type": "object",
      "required": [
        "id",
        "appearance",
        "decorations"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "score"
            ]
          },
          {
            "required": [
              "events"
            ]
          },
          {
            "required": [
              "player"
            ]
          },
          {
            "required": [
              "interaction"
            ]
          },
          {
            "required": [
              "script"
            ]
          },
          {
            "required": [
              "handlers"
            ]
          }
        ]
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[-a-zA-Z0-9_]{1,80}$"
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "displayName": {
          "type": "string",
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "maxLength": 160
        },
        "template": {
          "const": "template"
        },
        "appearance": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/color"
          }
        },
        "materials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "backdropGlowOpacity": {"type": "number", "minimum": 0, "maximum": 1},
            "panelShadowOpacity": {"type": "number", "minimum": 0, "maximum": 1},
            "panelEdgeOpacity": {"type": "number", "minimum": 0, "maximum": 1},
            "surfaceGradient": {
              "type": "boolean"
            },
            "activeGradient": {
              "type": "boolean"
            },
            "surfaceAngle": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "activeAngle": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            }
          }
        },
        "rollPalette": {
          "type": "object",
          "required": [
            "base",
            "light",
            "medium",
            "dark",
            "label",
            "anchor"
          ],
          "additionalProperties": false,
          "properties": {
            "base": {
              "$ref": "#/$defs/color"
            },
            "light": {
              "$ref": "#/$defs/color"
            },
            "medium": {
              "$ref": "#/$defs/color"
            },
            "dark": {
              "$ref": "#/$defs/color"
            },
            "label": {
              "$ref": "#/$defs/color"
            },
            "anchor": {
              "$ref": "#/$defs/color"
            }
          }
        },
        "keyFeedback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "element": {
              "type": [
                "string",
                "null"
              ]
            },
            "shape": {
              "enum": [
                "snowflake",
                "star",
                "spark",
                "butterfly",
                "drop",
                "diamond"
              ]
            },
            "colors": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "$ref": "#/$defs/color"
              }
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "durationMs": {
              "type": "number",
              "minimum": 180,
              "maximum": 1500
            },
            "sizePx": {
              "type": "number",
              "minimum": 6,
              "maximum": 24
            },
            "spreadPx": {
              "type": "number",
              "minimum": 8,
              "maximum": 100
            },
            "risePx": {
              "type": "number",
              "minimum": 8,
              "maximum": 100
            }
          }
        },
        "decorations": {
          "type": "object",
          "properties": {
            "ornaments": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "$ref": "#/$defs/asset"
              }
            },
            "companion": {
              "anyOf": [
                {
                  "$ref": "#/$defs/asset"
                },
                {
                  "type": "null"
                }
              ]
            },
            "layout": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "sceneFit": {
                  "enum": [
                    "contain",
                    "cover"
                  ]
                },
                "companionWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 95
                },
                "companionHeight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 95
                },
                "companionLeft": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 95
                },
                "companionBottom": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 95
                },
                "ornamentWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 95
                },
                "ornamentHeight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 95
                },
                "ornamentRight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 95
                },
                "ornamentBottom": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 95
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "asset": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^assets/(?!.*\\.\\.)(?!.*[:\\\\]).+\\.(png|webp|jpe?g|svg)$"
    }
  }
}
